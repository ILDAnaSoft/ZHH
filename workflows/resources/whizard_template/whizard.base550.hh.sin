! Thanks to Junping Tian and Mikael Berggren
! Base for all WhizardEventGeneration law tasks at 550 GeV COM energy that
! generate double-Higgs (HH) signal processes, e.g. n1n1hh / n23n23hh / e1e1hh
! / qqhh (and their fac_gh3 = kappa_lambda variations in the SM_ac_CKM model).
!
! Ported from the ILD reference production sindarins for the SM_CKM
! E550-Test.P{n1n1hh,n23n23hh}.Gwhizard-2_8_5 samples (Junping Tian) and kept
! in sync with whizard.base250.sin. It deliberately differs from the SM
! background template whizard.base550.sin in two ways that matter for HH:
!
!   * ?resonance_history is NOT enabled. With it on, WHIZARD 3.x writes the
!     on-shell intermediate Z (ZHH, Z -> nu nu-bar) or W (WW-fusion) of the
!     signal diagrams into the LCIO MCParticle record. The reference 2.8.5
!     samples keep a flat  e+ e- -> nu nu-bar h h  hard record with no
!     explicit Z/W, so we leave resonance history off to reproduce it.
!
!   * $restrictions = "!H" is NOT set. The s-channel Higgs (H* -> H H)
!     diagram carries the entire kappa_lambda / fac_gh3 dependence, so
!     vetoing internal Higgs lines would remove the sensitivity a trilinear
!     coupling scan is built to measure.
!
! The process itself is supplied by the AnalysisConfiguration whizard_options'
! process_definition entry (see WhizardSteeringFileConstructor); it is expected
! to switch the model if required (e.g. model = SM_ac_CKM for a fac_gh3 scan)
! and to declare  process <PROCESS_NAME> = ... . No process is defined here, so
! process_definition must not be left empty for this template.
!
! WhizardSteeringFileConstructor fills the placeholders below by a plain global
! string replace, so PROCESS_DEFINITION / PROCESS_NAME / NEVENTS / BEAMPOL1 /
! BEAMPOL2 / OUTPUT_NAME must only ever appear as their real $-prefixed tokens,
! never inside prose - hence the bare names used in these comments.

model = SM_CKM

! ##################################################################################
! Aliases (mirrors the reference sindarins/aliases.sin; the config's
! process_definition may redefine these, which WHIZARD allows)
! ##################################################################################

  alias quark      = u:d:s:c:b:U:D:S:C:B
  alias lepton     = e1:e2:e3:E1:E2:E3
  alias neutrino   = n1:n2:n3:N1:N2:N3
  alias not_nu_e   = n2:n3:N2:N3

! ##################################################################################
! Process - supplied by AnalysisConfiguration.whizard_options.process_definition
! ##################################################################################

$PROCESS_DEFINITION

! ##################################################################################
! Physics parameters - set after the process_definition block above so that a
! model = ... switch inside it (SM -> SM_ac_CKM) cannot reset them to that
! model's defaults.
!   - massless s/c/b and a vanishing alpha_s keep QCD radiation out of the matrix
!     element so it is not double counted with the Pythia parton shower
!   - the Higgs is pinned to its production values regardless of the active model
! ##################################################################################

  ms = 0 GeV
  mc = 0 GeV
  mb = 0 GeV
  alphas = 1.e-6

  mH = 125 GeV
  wH = 4.1 MeV

polarized e1,E1,e2,E2,e3,E3,n1,N1,n2,N2,n3,N3,u,U,d,D,s,S,c,C,b,B,t,T, "W+", "W-", Z, A

! ##################################################################################
! Beams and integration (mirrors the reference sindarins/integration-hh2.sin)
! ##################################################################################

sqrts = 550 GeV

beams = e1, E1 => circe2 => isr, isr
$circe2_design = "ILC"
?circe2_polarized = false
! copied into the run directory from the template dir alongside this file
$circe2_file = "550_TDR_ws_ee021.circe"

?isr_recoil = false
?isr_handler = true
$isr_handler_mode = "recoil"
isr_alpha = 0.0072993
isr_mass = 0.000511 GeV

beams_pol_density = @($BEAMPOL1),@($BEAMPOL2)
beams_pol_fraction = 1.0,1.0

real default_Mqq_cut = 10 GeV
real default_Mll_cut = 10 GeV
cuts =  all M > default_Mqq_cut [ quark,  quark ]  and
        all M > default_Mll_cut [ lepton, lepton ] and
        all M < -default_Mll_cut [ incoming e1, e1 ] and
        all M < -default_Mll_cut [ incoming E1, E1 ]

iterations = 1:500000, 10:500000, 1:1000000
relative_error_goal = 0.01

$integration_method = "vamp2"
$rng_method = "rng_stream"

! ##################################################################################
! Pythia6 hadronization / shower - OPAL tune, inclusive SM Higgs decays
! (mirrors the reference sindarins/pythia6-parameters.sin, is_higgs_exclusive = false)
! ##################################################################################

?ps_fsr_active = true
?ps_taudec_active = true
ps_tauola_dec_mode1 = 0
ps_tauola_dec_mode2 = 0

$ps_PYTHIA_PYGIVE = "MSTJ(28)=2;PMAS(25,1)=125.0;PMAS(25,2)=0.0043;MSTJ(41)=2; MSTU(22)=20; PARJ(21)=0.40000; PARJ(41)=0.11000; PARJ(42)=0.52000; PARJ(81)=0.25000;PARJ(82)=1.90000; MSTJ(11)=3; PARJ(54)=-0.03100; PARJ(55)=-0.00200;PARJ(1)=0.08500; PARJ(3)=0.45000; PARJ(4)=0.02500; PARJ(2)=0.31000;PARJ(11)=0.60000; PARJ(12)=0.40000; PARJ(13)=0.72000; PARJ(14)=0.43000;PARJ(15)=0.08000; PARJ(16)=0.08000; PARJ(17)=0.17000; MSTP(3)=1; MSTP(125)=2; MWID(25)=2;BRAT(210)=0.000052;BRAT(211)=0.000012;BRAT(212)=0.000246;BRAT(213)=0.0289;BRAT(214)=0.582;BRAT(219)=0.000218;BRAT(220)=0.0627;BRAT(222)=0.0819;BRAT(223)=0.00227;BRAT(224)=0.00153;BRAT(225)=0.0262;BRAT(226)=0.214;MDME(210,1)=0;MDME(211,1)=0"

$shower_method = "PYTHIA6"

! ##################################################################################
! Simulation / output
! ##################################################################################

?keep_remnants = true
?keep_beams = true
?hadronization_active = true
sample_format = lcio
?write_raw = false

n_events = $NEVENTS

integrate ($PROCESS_NAME) { ?polarized_events = true ?vis_channels = true }
show(results)
?rebuild_events = true
$sample = "$OUTPUT_NAME"
simulate ($PROCESS_NAME) { ?polarized_events = true }
